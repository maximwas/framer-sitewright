# sitewright reads this file from the repository root (Claude Code starts the server there and sets
# CLAUDE_PROJECT_DIR). Variables already set in the environment win. A blank value counts as unset.
# Paths must be absolute: this file does not expand ~.

# --- Server API (framer-api) ---------------------------------------------------------------------
# Both are needed for the Server API transport (DSL, screenshots, the DSL reference).
# Framer Server API key: project Site Settings → General → API Keys
FRAMER_API_KEY=
# Sandbox project URL, e.g. https://framer.com/projects/Name--aabbccdd1122
FRAMER_PROJECT_URL=

# --- Transport ------------------------------------------------------------------------------------
# auto | server-api | plugin. auto puts the plugin first: while it is connected, everything it can do runs there and
# only DSL work (design_apply, nodes_read, screenshots) goes to the Server API; without the plugin, the Server API.
# The framer_connect tool switches it at runtime.
# SITEWRIGHT_TRANSPORT=auto

# --- Plugin bridge (WebSocket between this server and the Framer plugin) -------------------------
# on | off. off: no bridge, so the plugin transport is unavailable.
# SITEWRIGHT_PLUGIN_BRIDGE=on
# Comma-separated http(s) origins that may open the bridge: the plugin's dev server. Never "null";
# entries that are not http(s) origins are ignored with a warning.
# SITEWRIGHT_PLUGIN_ORIGINS=https://localhost:5173
# Bridge port, an integer from 1024 to 65535; default 18710. It only applies when bridge.json is
# created: after that the file's port wins, so delete bridge.json (see SITEWRIGHT_HOME) to change it,
# then restart the MCP server and `pnpm dev:plugin`.
# SITEWRIGHT_BRIDGE_PORT=18710
# Directory of bridge.json (the port and the secret token that this server shares with the plugin's
# dev server; both must see the same directory), of history/, the activity journal, of settings.json, the plugin's
# switches, and of logs/, the log every sitewright process appends to (`pnpm logs` follows it). Default: ~/.sitewright
# SITEWRIGHT_HOME=

# --- Activity journal ----------------------------------------------------------------------------------
# on | off. on: every tool call is journaled in SITEWRIGHT_HOME/history/<project id>.jsonl (readable by you
# only), so the AI's changes (color tokens, text styles, design_apply edits) can be undone: activity_* tools, the
# plugin window, or the web journal from activity_open. off: nothing is recorded and nothing can be undone.
# SITEWRIGHT_HISTORY=on

# --- Logs and caches ------------------------------------------------------------------------------
# fatal | error | warn | info | debug | trace | silent. Logs go to stderr.
# LOG_LEVEL=info
# Where the Framer DSL reference is cached (refreshed after 7 days). Default: ~/.cache/sitewright
# SITEWRIGHT_CACHE_DIR=
