# Only the integration tests read this file (`pnpm test:integration`): the sandbox project they change freely.
# The Sitewright server reads no .env: keys are saved per project with `sitewright key`, and its settings come from
# the MCP client's environment (apps/server/README.md, Configuration).

# Framer Server API key of the sandbox: project Site Settings → General → API Keys
FRAMER_API_KEY=
# Sandbox project URL, e.g. https://framer.com/projects/Name--aabbccdd1122
FRAMER_PROJECT_URL=
